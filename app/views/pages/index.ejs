<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Express Vlidator</title>
</head>
<body>

    <% 
    let erroValidacao = {"nome":"", "email":"", "cpf":""};
    let msgErro = {"nome":"", "email":"", "cpf":""};
    if (erros) {
        erros.errors.forEach(function(erro) {
           if (erro.path == "name"){
            erroValidacao.nome = "erro";
            msgErro.nome = erro.msg;
           }
              if (erro.path == "email"){
                erroValidacao.email = "erro";
                msgErro.email = erro.msg;
              }
                if (erro.path == "cpf"){
                    erroValidacao.cpf = "erro";
                    msgErro.cpf = erro.msg;
                }
        });
    }
    %>
    <form method="post" action="/index">

        <label for="nome">Nome:</label>
        <input type="text" id="nome" name="nome" value="<%= valores.nome %>" class="<%= erroValidacao.nome %>">
        <span><%= msgErro.nome %></span>
        <br>

        <label for="email">Email:</label>
        <input type="text" id="email" name="email" value="<%= valores.email %>" class="<%= erroValidacao.email %>">
        <span><%= msgErro.email %></span>
        
        <br>

        <label for="cpf">CPF:</label>
        <input type="text" id="cpf" name="cpf" value="<%= valores.cpf %>" class="<%= erroValidacao.cpf %>">
        <span><%= msgErro.cpf %></span>

        <button type="submit">Enviar</button>
    </form>

    <% if(retorno) { %>
        <h3>Temos dados de retorno</h3> 
        <span>Nome: <%= retorno.nome %></span>
        <br>
        <span>Email: <%= retorno.email %></span>
        <br>
        <span>CPF: <%= retorno.cpf %></span>
    <% } else { %>
        <h3>Não temos dados de retorno</h3>
    <% } %>

</body>
</html>